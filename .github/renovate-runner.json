{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "platform": "github",
  "autodiscover": false,
  "forkProcessing": "enabled",
  "onboarding": false,
  "requireConfig": "optional",
  "username": "github-actions[bot]",
  "gitAuthor": "github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>",
  "useCloudMetadataServices": false,
  "detectHostRulesFromEnv": false,
  "detectGlobalManagerConfig": false,
  "exposeAllEnv": false,
  "allowedEnv": [],
  "allowScripts": false,
  "allowPlugins": false,
  "allowedCommands": [],
  "allowShellExecutorForPostUpgradeCommands": false,
  "allowCustomCrateGitRegistries": false,
  "binarySource": "global",
  "persistRepoData": false,
  "enabledManagers": ["cargo"],
  "baseBranchPatterns": ["$default"],
  "automerge": false,
  "platformAutomerge": false,
  "rangeStrategy": "auto",
  "lockFileMaintenance": { "enabled": false },
  "dependencyDashboard": true,
  "prConcurrentLimit": 2,
  "prHourlyLimit": 1,
  "minimumReleaseAge": "3 days",
  "prBodyNotes": [
    "Preserve the declared MSRV, features and repository lockfile policy. Require current-head CI, human review and the merge queue; do not use bypass permissions."
  ],
  "vulnerabilityAlerts": {
    "automerge": false,
    "platformAutomerge": false
  },
  "cargo": {
    "automerge": false,
    "platformAutomerge": false,
    "rangeStrategy": "auto",
    "packageRules": [
      {
        "description": "Disable nested Cargo manifests without matching root lockfile references.",
        "matchFileNames": ["**/Cargo.toml", "!Cargo.toml"],
        "enabled": false,
        "automerge": false,
        "platformAutomerge": false
      },
      {
        "description": "Review root-manifest updates individually while preserving inherited dependency holds.",
        "matchFileNames": ["Cargo.toml"],
        "automerge": false,
        "platformAutomerge": false,
        "rangeStrategy": "auto",
        "groupName": null
      },
      {
        "matchFileNames": ["Cargo.toml"],
        "matchCurrentVersion": "<1.0.0",
        "matchUpdateTypes": ["minor"],
        "prBodyNotes": [
          "Pre-1.0 minor update: potentially breaking. Review compatibility and actual MSRV results before ordinary reviewed/queued merge."
        ]
      }
    ]
  },
  "force": {
    "branchPrefix": "renovate-ci/",
    "baseBranchPatterns": ["$default"],
    "automerge": false,
    "platformAutomerge": false,
    "platformCommit": "enabled",
    "lockFileMaintenance": { "enabled": false }
  }
}
